# Production Environment Variables for Railway

# U-2-Net Model URL (170MB ONNX file)
# Option 1: GitHub Releases (Recommended - Free & Reliable)
NEXT_PUBLIC_MODEL_URL=https://github.com/NobinSijo7T/Dosametry_useless_project/releases/download/v1.0.0/model.onnx

# Option 2: Google Drive Direct Download
# NEXT_PUBLIC_MODEL_URL=https://drive.google.com/uc?export=download&id=YOUR_FILE_ID

# Option 3: Cloudflare R2 / AWS S3
# NEXT_PUBLIC_MODEL_URL=https://your-bucket.r2.cloudflarestorage.com/model.onnx

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Sarvam API (if using Ask Amma feature)
# SARVAM_API_KEY=your_api_key_here
